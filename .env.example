# ==============================================================================
# SLTV VTU BACKEND - RAILWAY ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# General Application Settings
PROJECT_NAME="VTU Backend"
FRONTEND_URL=https://ezyvtu.com.ng
SECRET_KEY=your_production_secret_key_here

# Database Configuration (Railway automatically sets DATABASE_URL when PostgreSQL plugin is added)
# Format: postgresql://username:password@hostname:5432/database_name
DATABASE_URL=${DATABASE_URL}

# JWT Authentication Keys (RSA 256)
# Paste PEM content directly or use escaped newlines \n
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# MobileNig Integration
MOBILENIG_PUBLIC_KEY=your_mobilenig_public_key
MOBILENIG_SECRET_KEY=your_mobilenig_secret_key

# Paystack Payment Gateway
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_SECRET_KEY=your_paystack_secret_key

# SMTP Email Configuration
SMTP_HOST=mail.ezyvtu.com.ng
SMTP_PORT=465
SMTP_USER=support@ezyvtu.com.ng
SMTP_PASSWORD=your_smtp_password
MAIL_FROM=support@ezyvtu.com.ng
MAIL_FROM_NAME="EZY VTU"

# SLTV Portal Credentials (Headless Chrome Automation)
SLTV_USERNAME=your_sltv_username
SLTV_PASSWORD=your_sltv_password

# VTPass Integration
VTPASS_API_KEY=your_vtpass_api_key
VTPASS_PUBLIC_KEY=your_vtpass_public_key
VTPASS_SECRET_KEY=your_vtpass_secret_key

# eBills Africa Integration
EBILLS_USERNAME=your_ebills_username
EBILLS_PASSWORD=your_ebills_password
